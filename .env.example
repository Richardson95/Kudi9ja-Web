# Where the Kudi9ja API lives, including /api/v1.
#
# Leave unset in development: the dev server forwards /api to the backend
# (see KUDI9JA_API_PROXY below), so the browser never makes a cross-origin call.
#
# Set it for a production build, and add this website's address to the
# backend's CORS_ORIGINS, or the browser will refuse every response.
#   VITE_API_BASE_URL=https://kudi9ja-mobile-backend.onrender.com/api/v1
VITE_API_BASE_URL=

# Development only: which server `npm run dev` forwards /api to.
# Point it at a local backend with  http://localhost:8080
KUDI9JA_API_PROXY=
